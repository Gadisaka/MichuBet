# Copy to `backend/.env` on the VPS (same filename the app already uses).
# `docker-compose.prod.yml` overrides DATABASE_URL and REDIS_URL to use the
# compose services; you do not need to duplicate those here unless you remove
# those `environment` entries from the compose file.

NODE_ENV=production
PORT=3001

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"

REDIS_KEY_PREFIX="kizzabet"

# --- API-Sports (required for ingestion) ---
ENABLED_SPORTS=football
API_FOOTBALL_KEY=
# For bare `node index.js` you need true here to run bootstrap. With
# `docker-compose.prod.yml`, the backend service sets ENABLE_API_FOOTBALL_CRON=true
# in the compose `environment` block (recommended); this value is then overridden.
ENABLE_API_FOOTBALL_CRON=false

API_SPORTS_CACHE_TTL=300
API_SPORTS_DAILY_LIMIT=75000

RUN_WORKER_INLINE=false

FIXTURES_DAYS_AHEAD=14
FIXTURES_TODAY_HOURS=2
FIXTURES_FUTURE_HOURS=6
LEAGUES_META_DAYS=7
LIVE_POLL_SECONDS=30
ODDS_INTERVAL_SECONDS=120
ODDS_MAX_FIXTURES_PER_RUN=250
ODDS_HORIZON_BACKFILL_MAX=500
ODDS_BACKFILL_PASSES=3

DEFAULT_BOOKMAKER_API_ID=
ODDS_ALLOWED_MARKETS=
FORCE_BOOTSTRAP=false
